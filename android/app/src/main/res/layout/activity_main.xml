<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="دستیار برنامه‌ریز روزانه"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="در حال بارگذاری..."
            android:padding="12dp"
            android:background="#F0F0F0"
            android:layout_marginBottom="16dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙ تنظیمات (شماره و GitHub)"
            android:layout_marginBottom="8dp" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#CCCCCC" android:layout_margin="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ورود به روبیکا"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnSendOtp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="دریافت کد OTP از روبیکا"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etOtp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="کد OTP را اینجا وارد کن"
            android:inputType="number"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnVerifyOtp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تأیید کد و ورود"
            android:layout_marginTop="4dp" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#CCCCCC" android:layout_margin="8dp" />

        <Button
            android:id="@+id/btnStartService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶ شروع جمع‌آوری (هر ۵ دقیقه)"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="لاگ‌های اخیر:"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="#1C1C1C"
            android:textColor="#00FF88"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:minHeight="120dp"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</ScrollView>

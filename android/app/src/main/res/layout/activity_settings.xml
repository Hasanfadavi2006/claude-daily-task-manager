<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="شماره روبیکا (+98912...)" android:layout_marginBottom="2dp"/>
        <EditText android:id="@+id/etPhone"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="phone" android:hint="+98912..."
            android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="GitHub Token (ghp_...)" android:layout_marginBottom="2dp"/>
        <EditText android:id="@+id/etGhToken"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textPassword" android:hint="ghp_..."
            android:layout_marginBottom="4dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="از github.com ← Settings ← Developer Settings ← Fine-grained tokens"
            android:textSize="11sp" android:textColor="#888888"
            android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="GitHub Owner" android:layout_marginBottom="2dp"/>
        <EditText android:id="@+id/etGhOwner"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="hasanfadavi2006" android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="GitHub Repo" android:layout_marginBottom="2dp"/>
        <EditText android:id="@+id/etGhRepo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="claude-daily-task-manager" android:layout_marginBottom="24dp"/>

        <Button android:id="@+id/btnSave"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="💾 ذخیره"/>

    </LinearLayout>
</ScrollView>
